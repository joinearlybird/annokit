# Copy to .env.local, then run `npx annokit server` in another terminal.
# The overlay stays off until both of these are set and the server answers.
EXPO_PUBLIC_ANNOKIT_ENDPOINT=http://localhost:4788
# Android emulator:  EXPO_PUBLIC_ANNOKIT_ENDPOINT=http://10.0.2.2:4788
# Physical phone:    start the server with HOST=0.0.0.0 npx annokit server,
#                    then paste the endpoint and token lines it prints.
EXPO_PUBLIC_ANNOKIT_SESSION_ID=example-session
